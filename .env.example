# Copy this file to `.env` and fill it in. `.env` is gitignored.
#
# 1. Turn on 2-Step Verification for the Google account
#      https://myaccount.google.com/security
# 2. Generate an App Password
#      https://myaccount.google.com/apppasswords
#    Regular Gmail passwords do not work. "Less Secure Apps" was removed in
#    2022, so an App Password is the only option short of OAuth 2.0.
# 3. Paste the 16-character App Password below as SMTP_APP_PASSWORD
#
# On Vercel, add the same names as Environment Variables, mark
# SMTP_APP_PASSWORD as Sensitive, and redeploy.

SMTP_USER=amritkhamcha@gmail.com
SMTP_APP_PASSWORD=

# Defaults shown below. Change these to switch providers without touching code,
# e.g. Brevo: smtp-relay.brevo.com / 587 / SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Where the message is sent from and to. Both default to SMTP_USER.
MAIL_FROM=amritkhamcha@gmail.com
MAIL_TO=amritkhamcha@gmail.com

# Port the local dev API server listens on (vite proxies /api to it).
DEV_API_PORT=8787
